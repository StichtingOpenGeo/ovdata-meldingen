# Copy to .env and edit. `docker compose` reads .env automatically.

# --- required ---------------------------------------------------------------
DB_PASS=change-me-database-password

# --- forum ------------------------------------------------------------------
# FORUM_URL must match how you reach the forum in the browser, port included.
# Flarum bakes it into generated links; get it wrong and assets/redirects break.
FORUM_URL=http://localhost:8888
HTTP_PORT=8888
FORUM_TITLE=My Forum

# Default language for guests and new accounts: nl or en (both packs are
# installed). Individual users can switch in their own settings regardless.
# Applied on first install only; afterwards change it in Admin -> Basics.
FORUM_LOCALE=nl

# Leave ADMIN_PASS empty to have one generated and printed on first boot.
ADMIN_USER=admin
ADMIN_MAIL=admin@example.com
ADMIN_PASS=

# --- database ---------------------------------------------------------------
DB_NAME=flarum
DB_USER=flarum

# --- mail -------------------------------------------------------------------
# "log" writes mail to storage/logs/flarum.log — handy locally, since that is
# where registration confirmation links end up. Use "smtp" for a real forum.
MAIL_DRIVER=log
MAIL_FROM=noreply@localhost
#MAIL_HOST=
#MAIL_PORT=587
#MAIL_USERNAME=
#MAIL_PASSWORD=
#MAIL_ENCRYPTION=tls

# Extensions enabled on first install, on top of Flarum's bundled set.
# Comma separated; ids, not package names (fof/gamification -> fof-gamification).
ENABLE_EXTENSIONS=fof-gamification,flarum-lang-dutch

# Primary tags (categories) are created from tags.json on first install.
# Set to true to also apply new entries from that file on every restart; the
# seeder only ever adds missing slugs, it never edits or removes existing ones.
SEED_TAGS_ALWAYS=false

# --- voting (applied on first install only; edit later in Admin -> Gamification)
# Vote on the opening post only, i.e. vote on topics rather than on replies.
VOTE_FIRST_POST_ONLY=true
VOTE_ALLOW_SELF_VOTES=false
VOTE_UPVOTES_ONLY=false
VOTE_LIST_LAYOUT=true
VOTE_SHOW_ON_LIST=true

# --- build ------------------------------------------------------------------
# Exact skeleton tag. composer.lock is generated against it, so after changing
# this you MUST re-run ./update-lock.sh — otherwise the application files and
# the locked dependencies come from different releases.
FLARUM_VERSION=v1.8.19

# Pin the extension too, or leave empty for the newest release compatible with
# the Flarum above. Also only takes effect via ./update-lock.sh.
GAMIFICATION_VERSION=

FLARUM_DEBUG=false
